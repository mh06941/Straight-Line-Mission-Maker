# Optional. Copy to .env; start uvicorn with --env-file ../.env from backend/.
# No API keys are required for the default public providers.
OSM_USER_AGENT=StraightLine/0.1 (local development; github.com/mh06941/Straight-Line-Mission-Maker)
OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOCODE_URL=https://nominatim.openstreetmap.org/search
STRAIGHTLINE_DATA_DIR=data
OSM_CACHE_TTL_SECONDS=86400
MAX_MISSION_DISTANCE_M=25000
MAX_QUERY_AREA_KM2=400
